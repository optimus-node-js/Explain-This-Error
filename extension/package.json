{
  "name": "explain-this-error-extension",
  "version": "1.0.0",
  "description": "Highlight any error → instantly understand it + get fix suggestions",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "bun run build && cd dist && powershell Compress-Archive -Path * -DestinationPath ../explain-this-error.zip -Force",
    "package:unix": "bun run build && cd dist && zip -r ../explain-this-error.zip *",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "install:chrome": "bun run package && echo 'Load the dist/ folder as unpacked extension in Chrome'",
    "start": "bun run dev"
  },
  "keywords": ["chrome-extension", "error-explanation", "developer-tools", "ai"],
  "author": "Explain This Error Team",
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@types/chrome": "^0.1.14",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
