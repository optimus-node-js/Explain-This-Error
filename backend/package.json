{
  "name": "explain-this-error-backend",
  "version": "1.0.0",
  "description": "Backend API for Explain This Error extension",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "keywords": ["api", "error-explanation", "ai", "developer-tools"],
  "author": "Explain This Error Team",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.6.1",
    "openai": "^5.23.2",
    "pino": "^9.12.0",
    "prisma": "^6.16.2",
    "redis": "^5.8.2",
    "zod": "^4.1.11"
  }
}